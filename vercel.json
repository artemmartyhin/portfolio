{
  "framework": null,
  "installCommand": "",
  "buildCommand": "rm -rf dist && mkdir dist && cp -r index.html styles.css script.js assets dist/",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
